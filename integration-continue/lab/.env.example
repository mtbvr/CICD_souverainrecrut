# Modèle de configuration du lab.
# scripts/start-lab.sh crée automatiquement .env à partir de ce fichier
# (DOCKER_GID détecté, mot de passe généré). Ne jamais commiter .env.

# Adresse d'écoute de Jenkins (8080) et SonarQube (9000)
#  - 0.0.0.0   : VM locale VMware (accès direct depuis le poste)
#  - 127.0.0.1 : VPS exposé sur Internet (accès par tunnel SSH uniquement)
BIND_ADDRESS=0.0.0.0

# Ports publiés sur l'hôte (à changer s'ils sont déjà pris)
JENKINS_PORT=8080
SONAR_PORT=9000

# GID du groupe docker sur la VM (getent group docker | cut -d: -f3)
DOCKER_GID=

# Base PostgreSQL de SonarQube
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=

# Versions des images (épingler une version précise pour la reproductibilité)
SONARQUBE_TAG=community
POSTGRES_TAG=17-alpine
