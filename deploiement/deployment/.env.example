# =============================================================
# Modèle de configuration du déploiement.
# Le .env réel est GÉNÉRÉ sur le serveur par le pipeline GitLab
# à partir des variables CI/CD protégées. Ne jamais le commiter.
# =============================================================

# Image Backend publiée par Jenkins sur Docker Hub
BACKEND_IMAGE=docker.io/<COMPTE_DOCKERHUB>/souverainrecrut-backend
# Tag immuable <version>-<commit> à déployer
BACKEND_TAG=1.0.0-172892d

# Port d'exposition de l'API sur le serveur
API_PORT=4000

# PostgreSQL (mot de passe : caractères hexadécimaux, sans caractère spécial)
#   openssl rand -hex 24
POSTGRES_DB=souverainrecrut
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=

# Secret de signature des JWT
#   openssl rand -hex 32
JWT_SECRET=

# Origine autorisée par CORS
FRONTEND_URL=http://localhost:5173
